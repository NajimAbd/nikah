[
  {
    "id": "NikahContest001",
    "name": "Nikah Contest",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "nikah-contest",
          "responseMode": "responseNode",
          "options": {
            "allowedOrigins": "*"
          }
        },
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          300
        ],
        "webhookId": "nikah-contest-0001",
        "id": "nikah-contest-n00"
      },
      {
        "parameters": {
          "jsCode": "const b = $input.first().json.body || {};\nconst esc = (s) => \"'\" + String(s).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\").replace(/\\0/g, '') + \"'\";\nconst token = String(b.token || '');\nconst action = String(b.action || 'info');\nif (!/^[a-f0-9]{64}$/.test(token)) return [{ json: { ok: false, error: 'lien_invalide' } }];\nif (['info', 'submit'].indexOf(action) === -1) return [{ json: { ok: false, error: 'requete_invalide' } }];\nconst texte = String(b.texte || '').replace(/\\r/g, '').trim();\nlet q0 = 'SELECT 1';\nif (action === 'submit') {\n  if (texte.length < 10 || texte.length > 2000) return [{ json: { ok: false, error: 'texte_invalide' } }];\n  q0 = \"UPDATE member_sanctions SET status='contestee', contest_text=\" + esc(texte) + \", contested_at=NOW() WHERE contest_hash=SHA2('\" + token + \"',256) AND status='active' AND contested_at IS NULL\";\n}\nconst q1 = \"SELECT s.id, s.kind, s.days, DATE_FORMAT(s.created_at,'%d.%m.%Y') AS date, s.status, s.contest_text, (s.contested_at IS NOT NULL AND s.contested_at > DATE_SUB(NOW(), INTERVAL 1 MINUTE)) AS vient, m.display_name, m.email FROM (SELECT 1 AS x) d LEFT JOIN member_sanctions s ON s.contest_hash=SHA2('\" + token + \"',256) LEFT JOIN members m ON m.id=s.member_id\";\nreturn [{ json: { ok: true, action, q0, q1 } }];\n"
        },
        "name": "Prepare",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          200,
          300
        ],
        "id": "nikah-contest-n01"
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "c1",
                "leftValue": "={{ $json.ok === true }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "name": "Donnees valides",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
