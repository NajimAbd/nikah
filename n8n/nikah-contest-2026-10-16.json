        "name": "Lire sanction",
        "type": "n8n-nodes-base.mySql",
        "typeVersion": 2.4,
        "position": [
          1000,
          300
        ],
        "credentials": {
          "mySql": {
            "id": "gcGQgiKQ83lHOaak",
            "name": "MySQL account 2"
          }
        },
        "id": "nikah-contest-n05"
      },
      {
        "parameters": {
          "jsCode": "const r = $input.first().json;\nconst action = $('Prepare').first().json.action;\nif (r.id === null || r.id === undefined) return [{ json: { success: false, error: 'lien_invalide' } }];\nconst LIB = { warn: 'Avertissement', suspend: 'Suspension', exclude: 'Fermeture du compte' };\nconst out = { success: true, type: r.kind, libelle: LIB[r.kind] || r.kind, jours: r.days, date: r.date, statut: r.status };\nlet _mail = null;\nif (action === 'submit') {\n  if (!(r.status === 'contestee' && Number(r.vient) === 1)) return [{ json: { success: false, error: 'deja_traite', statut: r.status } }];\n  _mail = { to: 'info.najim1@gmail.com', subject: 'Nikah — contestation reçue (' + (r.display_name || r.email) + ')',\n    text: 'Bonjour,\\n\\n' + (r.display_name || '') + ' (' + r.email + ') conteste la sanction suivante : ' + (LIB[r.kind] || r.kind) + ' du ' + r.date + '.\\n\\nSon explication :\\n\\n' + r.contest_text + '\\n\\nVous pouvez annuler ou maintenir la sanction dans l\\'administration, onglet Signalements :\\nhttps://mariageislamique.ch/administration.html\\n\\nNikah — Commission disciplinaire' };\n}\nreturn [{ json: Object.assign(out, { _mail }) }];\n"
        },
        "name": "Formater",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1200,
