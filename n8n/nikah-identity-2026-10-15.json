    "parameters": {
     "jsCode": "const b = $input.first().json.body || {};\nconst token = String(b.token || '');\nif (!/^[a-f0-9]{64}$/.test(token)) return [{ json: { ok: false, error: 'session_invalide' } }];\nconst lire = (v) => {\n  const m = String(v || '').match(/^data:image\\/jpeg;base64,([A-Za-z0-9+\\/=]+)$/);\n  if (!m || m[1].length > 600000) return null;\n  const hex = Buffer.from(m[1], 'base64').toString('hex');\n  return hex.startsWith('ffd8ff') ? hex : null;\n};\nconst piece = lire(b.piece), selfie = lire(b.selfie);\nif (!piece || !selfie) return [{ json: { ok: false, error: 'images_invalides' } }];\nconst q0 = \"INSERT INTO member_documents (member_id,id_data,selfie_data,created_at) SELECT m.id, UNHEX('\" + piece + \"'), UNHEX('\" + selfie + \"'), NOW() FROM members m WHERE m.session_hash=SHA2('\" + token + \"',256) AND m.session_expires > NOW() AND m.status='actif' AND m.identity_verified=0 ON DUPLICATE KEY UPDATE id_data=VALUES(id_data), selfie_data=VALUES(selfie_data), created_at=NOW()\";\nconst q1 = \"SELECT COUNT(*) AS n FROM members m JOIN member_documents d ON d.member_id=m.id WHERE m.session_hash=SHA2('\" + token + \"',256) AND d.created_at > DATE_SUB(NOW(), INTERVAL 1 MINUTE)\";\nreturn [{ json: { ok: true, q0, q1 } }];\n"
    },
