      {
        "parameters": {
          "jsCode": "const crypto = require('crypto');\nconst body = $('Webhook').first().json.body || {};\nconst password = String(body.password || '');\nconst row = $input.first().json;\nconst found = row.id !== null && row.id !== undefined;\nconst DUMMY = 'pbkdf2:100000:00000000000000000000000000000000:' + '0'.repeat(64);\nconst parts = (found ? String(row.pass_hash) : DUMMY).split(':');\nconst calc = crypto.pbkdf2Sync(password, parts[2], parseInt(parts[1], 10), 32, 'sha256');\nconst expected = Buffer.from(parts[3], 'hex');\nconst same = calc.length === expected.length && crypto.timingSafeEqual(calc, expected);\nconst nope = (error, q) => [{ json: { ok: false, error, q: q || 'SELECT 1' } }];\nif (!found) return nope('identifiants_invalides');\nif (Number(row.locked) === 1) return nope('compte_bloque');\nif (!same) {\n  // Au 5e essai raté, l'accès est bloqué 15 minutes et l'administrateur est prévenu par e-mail\n  const alerte = Number(row.login_failures || 0) + 1 === 5;\n  const quand = new Date().toLocaleString('fr-CH', { timeZone: 'Europe/Zurich', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });\n  return [{ json: { ok: false, error: 'identifiants_invalides', alerte, quand, q: \"UPDATE admin_access SET login_failures=login_failures+1, locked_until=IF(login_failures>=5, DATE_ADD(NOW(), INTERVAL 15 MINUTE), locked_until) WHERE id=1\" } }];\n}\nconst token = crypto.randomBytes(32).toString('hex');\nconst q = \"UPDATE admin_access SET session_hash=SHA2('\" + token + \"',256), session_expires=DATE_ADD(NOW(), INTERVAL 8 HOUR), login_failures=0, locked_until=NULL WHERE id=1\";\nreturn [{ json: { ok: true, token, q } }];\n"
        },
